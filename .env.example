# Copy this file to .env and fill in real values. NEVER commit .env.

APP_NAME="Red Devil"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://trader:trader_password@localhost:5432/trading_db

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379/0

# Trading mode. Stage 1 supports PAPER only.
# LIVE_TRADING_ENABLED=true is rejected at startup until the approval
# gateway and its integration tests exist.
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false

# Risk defaults (enforced in a later stage, stored now)
INITIAL_CAPITAL_INR=10000
MAX_RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=1.0
MAX_LEVERAGE=1.0
MAX_OPEN_POSITIONS=2

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
